[debug] [2026-11-06T17:56:50.598Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/physics-7a832/rulesets {"name":"projects/physics-7a832/rulesets/cf4ca81c-bcc1-488b-bbd4-7adf4657a44d","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() { return request.auth != null; }\n    function teacher() { return signedIn() && (request.auth.token.teacher == true || request.auth.token.email == 'e.galkin58@mail.ru'); }\n    match /users/{userId} {\n      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.email == request.auth.token.email;\n      allow read, update: if signedIn() && request.auth.uid == userId;\n      allow delete: if false;\n    }\n    match /teacherStudents/{linkId} {\n      allow read: if signedIn() && (resource.data.teacherId == request.auth.uid || resource.data.studentId == request.auth.uid);\n      allow create: if teacher() && request.resource.data.teacherId == request.auth.uid && (request.resource.data.studentId is string || request.resource.data.studentEmail is string);\n      allow update, delete: if teacher() && resource.data.teacherId == request.auth.uid;\n    }\n    match /assignments/{assignmentId} {\n      allow read: if signedIn();\n      allow create, update, delete: if teacher();\n    }\n    match /submissions/{submissionId} {\n      allow create: if signedIn() && request.resource.data.user == request.auth.token.email;\n      allow read: if teacher() || (signedIn() && resource.data.user == request.auth.token.email);\n      allow update: if teacher();\n      allow delete: if teacher() || (signedIn() && resource.data.user == request.auth.token.email);\n    }\n    match /attempts/{attemptId} {\n      allow create: if signedIn() && request.resource.data.user == request.auth.token.email;\n      allow read: if teacher() || (signedIn() && resource.data.user == request.auth.token.email);\n    }\n    match /examAttempts/{attemptId} {\n      allow create: if signedIn() && request.resource.data.user == request.auth.token.email;\n      allow read: if teacher() || (signedIn() && resource.data.user == request.auth.token.email);\n    }\n    match /quizResults/{resultId} {\n      allow create: if signedIn() && request.resource.data.user == request.auth.token.email;\n      allow read: if teacher() || (signedIn() && resource.data.user == request.auth.token.email);\n    }\n    match /questionBank/{questionId} {\n      allow read: if signedIn() && (teacher() || resource.data.verification == 'verified');\n      allow create, update, delete: if teacher();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-11-06T17:56:50.665151Z","metadata":{"services":["cloud.firestore"]}}
