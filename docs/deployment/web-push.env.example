# Web Push (server only; generate once with node scripts/generate-push-keys.mjs)
WEB_PUSH_ENABLED=false
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:your-contact@example.com
# Shared only with the external scheduler, never NEXT_PUBLIC_* or a URL parameter
PUSH_CRON_SECRET=
# Scheduler only: public HTTPS origin of the deployed web service
PUSH_DISPATCH_ORIGIN=https://physics-tutor-6ytz.onrender.com
