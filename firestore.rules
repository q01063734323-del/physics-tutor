rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function teacher() { return signedIn() && (request.auth.token.teacher == true || request.auth.token.email == 'e.galkin58@mail.ru'); }
    match /assignments/{assignmentId} {
      allow read: if signedIn();
      allow create, update, delete: if teacher();
    }
    match /submissions/{submissionId} {
      allow create: if signedIn() && request.resource.data.user == request.auth.token.email;
      allow read: if teacher() || (signedIn() && resource.data.user == request.auth.token.email);
      allow update: if teacher();
      allow delete: if teacher() || (signedIn() && resource.data.user == request.auth.token.email);
    }
    match /attempts/{attemptId} {
      allow create: if signedIn() && request.resource.data.user == request.auth.token.email;
      allow read: if teacher() || (signedIn() && resource.data.user == request.auth.token.email);
    }
    match /examAttempts/{attemptId} {
      allow create: if signedIn() && request.resource.data.user == request.auth.token.email;
      allow read: if teacher() || (signedIn() && resource.data.user == request.auth.token.email);
    }
    match /quizResults/{resultId} {
      allow create: if signedIn() && request.resource.data.user == request.auth.token.email;
      allow read: if teacher() || (signedIn() && resource.data.user == request.auth.token.email);
    }
  }
}
